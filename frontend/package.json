{
  "name": "ai-learning-machine-frontend",
  "version": "1.0.0",
  "description": "Interactive AI Learning Machine Web Frontend",
  "private": true,
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.17.0",
    "axios": "^1.17.0",
    "recharts": "^3.8.1",
    "react-icons": "^5.6.0",
    "date-fns": "^4.4.0",
    "@capacitor/core": "^8.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^4.9.5",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.19",
    "postcss": "^8.5.15",
    "autoprefixer": "^10.5.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/android": "^8.4.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "cap:init": "npx cap init ai-learning-machine com.connerjward95.ai --web-dir=build",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:build": "npm run build && npm run cap:sync",
    "android:build": "npm run cap:build && cd android && ./gradlew assembleRelease"
  },
  "eslintConfig": {
    "extends": ["react-app"]
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}
